NEXT_PUBLIC_PETLENS_API_URL=http://127.0.0.1:8000

# Optional: point the ML adapter at the exact ViT checkpoint produced by the course notebook.
# PETLENS_VIT_MODEL=/absolute/path/to/results/vit-pet/best

# The course 20.3 notebook used this CLIP checkpoint.
# PETLENS_CLIP_MODEL=openai/clip-vit-large-patch14

# PetLens 2.0 detection layer. Grounding DINO is lazy-loaded on the first image analysis request.
# PETLENS_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
# PETLENS_DETECTION_THRESHOLD=0.32
# PETLENS_DETECTION_TEXT_THRESHOLD=0.25

# PetLens 2.0 segmentation layer. SAM2 is lazy-loaded after detection.
# PETLENS_SEGMENTATION_ENABLED=1
# PETLENS_SEGMENTATION_MODEL=facebook/sam2-hiera-tiny

# Conservative open-set baseline. These thresholds only trigger a warning;
# they are not calibrated probabilities that a breed is unknown.
# PETLENS_UNKNOWN_TOP1_THRESHOLD=0.55
# PETLENS_UNKNOWN_MARGIN_THRESHOLD=0.12

# Optional comparison models. These are lazy-loaded only when their comparison endpoints are called.
# PETLENS_SIGLIP2_MODEL=google/siglip2-base-patch16-224
# PETLENS_DINO_MODEL=facebook/dinov2-small
# PETLENS_DINO_GALLERY_CACHE=/absolute/path/to/dino-gallery-embeddings.npy

# Optional video tracking / animal pose models. Both are lazy-loaded.
# PETLENS_VIDEO_MODEL=facebook/sam2-hiera-tiny
# PETLENS_POSE_MODEL=usyd-community/vitpose-plus-base
# PETLENS_VIDEO_MAX_MB=80
# PETLENS_VIDEO_MAX_FRAMES=12

# Optional persistent CLIP gallery embedding cache.
# PETLENS_GALLERY_CACHE=/absolute/path/to/gallery-embeddings.npy
