NEXT_PUBLIC_PETLENS_API_URL=http://127.0.0.1:8000

# Optional: point the ML adapter at the exact ViT checkpoint produced by the course notebook.
# PETLENS_VIT_MODEL=/absolute/path/to/results/vit-pet/best

# The course 20.3 notebook used this CLIP checkpoint.
# PETLENS_CLIP_MODEL=openai/clip-vit-large-patch14

# PetLens 2.0 detection layer. Grounding DINO is lazy-loaded on the first image analysis request.
# PETLENS_DETECTOR_MODEL=IDEA-Research/grounding-dino-tiny
# PETLENS_DETECTION_THRESHOLD=0.32
# PETLENS_DETECTION_TEXT_THRESHOLD=0.25

# Optional persistent CLIP gallery embedding cache.
# PETLENS_GALLERY_CACHE=/absolute/path/to/gallery-embeddings.npy
